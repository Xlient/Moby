# Copy to .env (gitignored) and fill in real values. Never commit .env.

# ════════════════════════════ Backend (moby/) ════════════════════════════
N_FACTORY_ACC_KEY=
DATABASE_URL=postgresql://moby:moby@localhost:5432/moby
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=moby
# Optional overrides (defaults in moby/config.py):
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NWS_USER_AGENT=moby-early-warning/0.1 (you@example.com)

# ══════════════════════════════ App (Expo) ═══════════════════════════════
# Only EXPO_PUBLIC_* variables are bundled into the app — never put secrets in them.
# Backend API. Leave unset to run on the built-in mock data.
EXPO_PUBLIC_API_URL=
# Force mock data on/off ("true"/"false"). Defaults to true when EXPO_PUBLIC_API_URL is unset.
EXPO_PUBLIC_USE_MOCK=

# Firebase web app config. Leave unset to skip sign-in.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth "Web client" ID (client_type 3 in google-services.json). Google Sign-In on Android
# asks for an ID token for this client, which Firebase Auth then accepts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Point Auth + Firestore at the local Emulator Suite instead of the real project.
# Normally set by `npm run start:emulators` (with `npm run emulators` running) rather than here.
# "localhost" is mapped to 10.0.2.2 inside the Android emulator; use your machine's LAN IP
# for a physical phone.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# --- Build-time only (read by app.config.ts, not bundled as JS) ---
# Google Maps SDK for Android key. Restrict it in Google Cloud to the Android app
# (package com.xlient.moby + signing SHA-1) and the Maps SDK for Android API.
GOOGLE_MAPS_API_KEY=

# Tianditu (天地图) key for the MapLibre preview's basemap inside mainland China (issue #21).
# Free from https://console.tianditu.gov.cn/api/key. Leave empty to use OpenFreeMap everywhere.
EXPO_PUBLIC_TIANDITU_KEY=
