<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!-- Android 12+: scan and advertise. We never work out location from what we hear,
       so the scan permission says so (no location prompt for Bluetooth on 12+). -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
      android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <!-- Android 11 and older: the legacy permissions (scanning also needs location there,
       which the app already asks for to show nearby alerts). -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <!-- Optional: the rest of Moby works on phones without Bluetooth LE. -->
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
</manifest>
