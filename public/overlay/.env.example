# Copy to .env. Everything here is optional: with nothing set, the app runs on
# built-in sample data (no account, no server needed).

# Moby API base URL (leave empty for sample data)
EXPO_PUBLIC_API_URL=
# Force sample data on/off ("true"/"false"). Defaults to true when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_USE_MOCK=

# Google Maps SDK key for Android (maps fall back to a drawn map without it)
GOOGLE_MAPS_API_KEY=
