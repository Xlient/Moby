{
  "name": "disaster-early-warning",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production",
    "build:android:local": "eas build --platform android --profile preview --local",
    "generate-types": "openapi-typescript api-contract-v1.yaml -o src/api/generated-types.ts",
    "emulators": "mkdir -p .firebase-emulator-data && npx -y firebase-tools@15 emulators:start --project demo-moby --import .firebase-emulator-data --export-on-exit",
    "deploy:firestore": "npx -y firebase-tools@15 deploy --only firestore:rules,firestore:indexes",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "start:emulators": "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-moby expo start --dev-client"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.2",
    "openapi-typescript": "^7.4.4",
    "typescript": "~5.9.3"
  }
}
